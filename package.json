{
  "name": "sheath-academy",
  "version": "2.22.2",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db": "dotenv -e .env.local -- jest --testPathPattern \"__tests__/integration/.*\\.db\\.test\\.(ts|tsx)$\" --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "node scripts/smoke.cjs",
    "setup-hooks": "sh scripts/setup-hooks.sh",
    "prepare": "sh scripts/setup-hooks.sh",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed:demo": "dotenv -e .env.local -- tsx scripts/seed-demo-households.ts",
    "db:wipe": "dotenv -e .env.local -- tsx scripts/db-wipe.ts",
    "db:reset:demo": "dotenv -e .env.local -- tsx scripts/db-wipe.ts && dotenv -e .env.local -- tsx scripts/seed-demo-households.ts",
    "steward:preflight": "dotenv -e .env.local -- tsx scripts/feedback-steward/steward-preflight.ts",
    "steward:daily": "dotenv -e .env.local -- tsx scripts/feedback-steward/run-daily.ts",
    "steward:execute": "dotenv -e .env.local -- tsx scripts/feedback-steward/run-execute.ts",
    "steward:rollback": "dotenv -e .env.local -- tsx scripts/feedback-steward/run-rollback.ts",
    "steward:ship": "dotenv -e .env.local -- tsx scripts/feedback-steward/run-ship.ts",
    "steward:notify": "dotenv -e .env.local -- tsx scripts/feedback-steward/feedback-notify.ts",
    "steward:reset-classification": "dotenv -e .env.local -- tsx scripts/feedback-steward/run-reset-classification.ts",
    "plan:execute": "tsx .claude/skills/plan-execute/run-execute.ts",
    "test:steward:integration": "dotenv -e .env.local -- jest --testPathPattern=\"feedback-steward/__tests__/integration\" --no-coverage --runInBand"
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@nivo/bar": "^0.83.0",
    "@nivo/core": "^0.83.0",
    "@nivo/line": "^0.83.0",
    "axios": "^1.6.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.294.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.31",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0"
  }
}
