# ─────────────────────────────────────────────────────────────────
# Sheath Academy — environment variables
#
# Next.js loads (project root): `.env`, then `.env.local` (overrides).
# For local dev: copy this file to `.env.local` and fill AUTH_SECRET (required).
# Never commit `.env` or `.env.local` — both are gitignored.
#
# Set the same vars in Render → Service → Environment for production
# ─────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────

# NextAuth / Auth.js v5 secret — signs JWTs and cookies (middleware will error without it).
# Generate: openssl rand -base64 32
# Same as NEXTAUTH_SECRET for older docs; prefer AUTH_SECRET.
# If missing: MissingSecret in middleware — every protected route fails.
AUTH_SECRET=

# Canonical app URL for OAuth redirects — required for local Google sign-in.
# Without this, Auth.js uses the browser Host header (e.g. 169.254.x.x:3000) and Google returns redirect_uri_mismatch.
AUTH_URL=http://localhost:3000

# Resend API key — used to send magic-link sign-in emails.
# Get one free at: https://resend.com → API Keys
# If missing: magic-link form submits but email is never sent; user sees "Something went wrong".
RESEND_API_KEY=

# PostgreSQL database connection string.
# Use the private/internal database URL from Render in production.
# Do not commit real credentials here; keep real values in `.env.local` or Render Environment.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sheath_academy_user:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/sheath_academy

# Optional individual PostgreSQL fields, if a script/tool expects split values instead of DATABASE_URL.
POSTGRES_HOST=REPLACE_WITH_HOST
POSTGRES_PORT=5432
POSTGRES_DB=sheath_academy
POSTGRES_USER=sheath_academy_user
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD

# ── Optional ──────────────────────────────────────────────────────

# Sender address shown in magic-link emails (defaults to no-reply@sheathacademy.com).
# Must be a verified domain in your Resend account — unverified domains return HTTP 403 and no email is sent.
# Local dev without a custom domain: AUTH_EMAIL_FROM=Sheath Academy <onboarding@resend.dev>
# Resend testing mode only delivers to the email on your Resend account (not arbitrary addresses).
# AUTH_EMAIL_FROM=Sheath Academy <no-reply@yourdomain.com>

# Dev bypass + seed user email — must match for local demo data to appear after db:seed:demo.
# Dev bypass sign-in uses this when DEV_BYPASS_SECRET is set; seed script targets the same user.
# Default if unset: dev@sheathacademy.ai (see features/lib/server/devUserEmail.ts).
# Do NOT set this in production.
# DEV_SEED_USER_EMAIL=dev@sheathacademy.ai

# DATABASE_URL is required — the app throws on startup if it is not set.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# App admin — email allowed to view /admin/metrics and validation APIs.
# Must match the signed-in user email (dev bypass default: dev@sheathacademy.ai).
# ADMIN_EMAIL=dev@sheathacademy.ai
# Deprecated alias: PRODUCT_VALIDATION_ADMIN_EMAIL=dev@sheathacademy.ai

# ── Dev / preview bypass ──────────────────────────────────────────
# Set BOTH vars to enable a password-protected dev login on the sign-in page.
# Leave unset (or remove) in production to disable completely.
#
# DEV_BYPASS_SECRET — any string you choose; entered as the bypass token on the login page.
# NEXT_PUBLIC_DEV_MODE — shows the bypass UI section on the login page.
#
# DEV_BYPASS_SECRET=your-secret-here
# NEXT_PUBLIC_DEV_MODE=true

# ── OAuth ───────────────────────────────────────────────────────────
# When AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET (and/or Facebook) are set, login shows those buttons.
# Local redirect URIs must be allowlisted, e.g. http://localhost:3000/api/auth/callback/google
#
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# Facebook: developers.facebook.com → My Apps → Facebook Login product
# Valid OAuth redirect URI: https://yourdomain.com/api/auth/callback/facebook
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
